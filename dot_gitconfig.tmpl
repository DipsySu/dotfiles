[user]
	name = {{ quote .name }}
	email = {{ quote .email }}

[core]
	autocrlf = input
	filemode = false
	excludesfile = {{ quote (printf "%s/.gitignore_global" .chezmoi.homeDir) }}

[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge --skip -- %f
	process = git-lfs filter-process --skip

[init]
	defaultBranch = main

[pull]
	rebase = true

[push]
	autoSetupRemote = true
	default = current

[rerere]
	enabled = true

[diff]
	colorMoved = zebra

[merge]
	conflictStyle = zdiff3

[alias]
	s = status -sb
	co = checkout
	br = branch
	cm = commit -m
	lg = log --graph --pretty=format:'%C(yellow)%h%Creset -%C(red)%d%Creset %s %C(green)(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
	last = log -1 HEAD --stat
	unstage = reset HEAD --
# Keep machine-specific credential helpers and private Git settings out of chezmoi.
[include]
	path = {{ quote (printf "%s/.gitconfig.local" .chezmoi.homeDir) }}
