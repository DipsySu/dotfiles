{{- /*
  私有变量文件：~/.config/chezmoi/local.toml（不进仓库，结构与下面 [data] 一致）。
  文件里出现的键直接生效、不再提问；没有的键才交互提问。
  新机器：先放好 local.toml，再 chezmoi init --apply。
*/ -}}
{{- $localPath := joinPath .chezmoi.homeDir ".config" "chezmoi" "local.toml" -}}
{{- $local := dict -}}
{{- if stat $localPath -}}
{{-   $local = include $localPath | fromToml -}}
{{- end -}}
{{- $d := merge $local . -}}
# Chezmoi 配置：由 .chezmoi.toml.tmpl 生成，值来自 ~/.config/chezmoi/local.toml 或交互提问。
# 不要手改本文件，改 local.toml 后重新 chezmoi init。

[data]
# Git
name  = {{ promptStringOnce $d "name" "Git username" "Dipsy" | quote }}
email = {{ promptStringOnce $d "email" "Git email" "you@example.com" | quote }}

# 开发工具版本（mise）
[data.versions]
go      = {{ promptStringOnce $d "versions.go" "Go version" "latest" | quote }}
java    = {{ promptStringOnce $d "versions.java" "Java version" "temurin-21" | quote }}
node    = {{ promptStringOnce $d "versions.node" "Node.js version" "lts" | quote }}
python  = {{ promptStringOnce $d "versions.python" "Python version" "3.11" | quote }}
flutter = {{ promptStringOnce $d "versions.flutter" "Flutter version" "3.35.3" | quote }}

# AWS profile 切换函数：只能通过 local.toml 提供，为空则不生成任何 aws 函数
[data.aws]
{{- $profiles := dig "aws" "profiles" (list) $d }}
codeartifact_domain = {{ dig "aws" "codeartifact_domain" "" $d | quote }}
{{- if not $profiles }}
profiles = []
{{- end }}
{{- range $p := $profiles }}

[[data.aws.profiles]]
name         = {{ $p.name | quote }}
region       = {{ $p.region | quote }}
sso          = {{ dig "sso" false $p }}
codeartifact = {{ dig "codeartifact" false $p }}
{{- end }}

# 家居自动化（Tailscale + SSH）
[data.home]
tailscale_path = {{ promptStringOnce $d "home.tailscale_path" "Tailscale executable path (blank for auto-detect)" "" | quote }}
ssh_host       = {{ promptStringOnce $d "home.ssh_host" "Home SSH host alias" "home-pc" | quote }}
pc_ip          = {{ promptStringOnce $d "home.pc_ip" "Home PC IP address" "192.168.1.100" | quote }}
# NAS：留空则不生成 sshnas / mountnas 别名
nas_ssh        = {{ promptStringOnce $d "home.nas_ssh" "NAS SSH target" "" | quote }}
nas_nfs        = {{ promptStringOnce $d "home.nas_nfs" "NAS NFS export" "" | quote }}

# Shell 功能开关
[data.shell]
enable_starship = {{ promptBoolOnce $d "shell.enable_starship" "Enable Starship prompt" true }}
enable_zoxide   = {{ promptBoolOnce $d "shell.enable_zoxide" "Enable Zoxide (smart cd)" true }}
enable_eza      = {{ promptBoolOnce $d "shell.enable_eza" "Enable Eza (better ls)" true }}

# 仅 WSL：从 WSL 看到的 Windows 用户目录，例如 /mnt/c/Users/<name>；macOS 留空
[data.wsl]
win_home = {{ promptStringOnce $d "wsl.win_home" "Windows profile dir from WSL" "" | quote }}
