#!/bin/bash
# 默认执行首次软件安装，可通过 bootstrap_packages=false 跳过。
{{- if eq (dig "bootstrap_packages" true .) false }}
echo "[INFO] bootstrap_packages=false，跳过软件初始化"
exit 0
{{- end }}

set -eu
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; NC='\033[0m'
bootstrap_failures=0
log_info() { echo -e "${GREEN}[INFO]${NC} $1"; }
log_warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
log_error() { echo -e "${RED}[ERROR]${NC} $1"; }
record_failure() { log_error "$1"; bootstrap_failures=$((bootstrap_failures + 1)); }

check_network() {
    if ! curl -s --head --max-time 10 https://github.com >/dev/null; then
        log_error "网络连接失败，请检查网络设置"; exit 1
    fi
}
check_dependencies() {
    for cmd in curl git; do
        command -v "$cmd" >/dev/null 2>&1 || { log_error "$cmd 未安装，请先安装"; exit 1; }
    done
}
log_info "开始 Dotfiles 初始化流程..."
[[ ":$PATH:" == *":$HOME/.local/bin:"* ]] || export PATH="$HOME/.local/bin:$PATH"
check_network
check_dependencies

if ! command -v brew >/dev/null 2>&1; then
    log_info "安装 Homebrew..."
    if brew_installer="$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"; then
        /bin/bash -c "$brew_installer" || record_failure "Homebrew 安装失败"
    else
        record_failure "无法下载 Homebrew 安装器"
    fi
    {{- if eq .chezmoi.os "linux" }}
    for brew_path in /home/linuxbrew/.linuxbrew/bin/brew /usr/local/bin/brew; do [ ! -x "$brew_path" ] || { eval "$("$brew_path" shellenv)"; break; }; done
    {{- else if eq .chezmoi.os "darwin" }}
    for brew_path in /opt/homebrew/bin/brew /usr/local/bin/brew; do [ ! -x "$brew_path" ] || { eval "$("$brew_path" shellenv)"; break; }; done
    {{- end }}
fi

if command -v brew >/dev/null 2>&1; then
    log_info "安装 Homebrew 软件包（不升级已有软件）..."
    {{- if eq (dig "enable_android" true .) false }}
    chezmoi_brewfile="$(mktemp "${TMPDIR:-/tmp}/chezmoi-brewfile.XXXXXX")"
    trap 'rm -f "$chezmoi_brewfile"' EXIT
    awk '!/^[[:space:]]*(brew|cask)[[:space:]]+"android-commandlinetools"/' "{{ .chezmoi.sourceDir }}/dot_Brewfile" >"$chezmoi_brewfile"
    brew bundle --no-upgrade --file="$chezmoi_brewfile" || record_failure "Homebrew 软件包安装失败"
    rm -f "$chezmoi_brewfile"; trap - EXIT
    {{- else }}
    brew bundle --no-upgrade --file="{{ .chezmoi.sourceDir }}/dot_Brewfile" || record_failure "Homebrew 软件包安装失败"
    {{- end }}
else
    record_failure "Homebrew 未找到，无法安装软件包"
fi

if command -v mise >/dev/null 2>&1; then
    mise install || record_failure "Mise 运行时安装失败"
else
    record_failure "Mise 未找到，无法安装运行时"
fi

if ! command -v zsh >/dev/null 2>&1; then
    {{ if eq .chezmoi.os "linux" }}
    if command -v apt-get >/dev/null 2>&1; then sudo apt-get update && sudo apt-get install -y zsh || record_failure "Zsh 安装失败"; elif command -v brew >/dev/null 2>&1; then brew install zsh || record_failure "Zsh 安装失败"; else record_failure "没有可用的 Zsh 安装器"; fi
    {{ else if eq .chezmoi.os "darwin" }}
    brew install zsh || record_failure "Zsh 安装失败"
    {{ end }}
fi
if command -v zsh >/dev/null 2>&1 && [[ "$SHELL" != *"/zsh" ]]; then
    {{ if eq .chezmoi.os "linux" }}
    sudo chsh -s "$(command -v zsh)" "$USER" || record_failure "默认 Shell 更新失败"
    {{ else if eq .chezmoi.os "darwin" }}
    chsh -s "$(command -v zsh)" || record_failure "默认 Shell 更新失败"
    {{ end }}
fi

if command -v git-lfs >/dev/null 2>&1; then git lfs install --skip-smudge >/dev/null 2>&1 || record_failure "Git LFS 初始化失败"; else record_failure "git-lfs 未找到"; fi
if command -v mise >/dev/null 2>&1; then mise reshim >/dev/null 2>&1 || record_failure "Mise reshim 失败"; fi

if [ "$bootstrap_failures" -ne 0 ]; then log_error "Dotfiles 初始化未完成：$bootstrap_failures 项失败"; exit 1; fi
log_info "Dotfiles 初始化完成！请关闭并重新打开终端。"
{{ if eq .chezmoi.os "linux" }}
log_info "如果重启后依然是 Bash，请尝试注销或重启 WSL (wsl --shutdown)。"
{{ end }}
