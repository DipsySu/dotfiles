# =================================================================
# Mise Configuration (Managed by Chezmoi)
# =================================================================

[tools]
{{- $fixedTools := list "go" "java" "node" "python" "flutter" "rust" }}
{{- $disabledMiseTools := dig "disabled_mise_tools" (list) . }}
{{ if not (has "go" $disabledMiseTools) -}}
go = "{{ .versions.go }}"
{{ end -}}
{{ if not (has "java" $disabledMiseTools) -}}
java = "{{ .versions.java }}"
{{ end -}}
{{ if not (has "node" $disabledMiseTools) -}}
node = "{{ .versions.node }}"
{{ end -}}
{{ if not (has "python" $disabledMiseTools) -}}
python = "{{ .versions.python }}"
{{ end -}}
{{ if not (has "flutter" $disabledMiseTools) -}}
flutter = {{ get .versions "flutter" | default "3.35.3" | quote }}
{{ end -}}
{{ if not (has "rust" $disabledMiseTools) -}}
rust = {{ get .versions "rust" | default "1.85.0" | quote }}
{{ end -}}
{{- $extraMiseTools := dig "extra_mise_tools" (dict) . }}
{{- range $tool := keys $extraMiseTools | sortAlpha }}
{{- if has $tool $fixedTools }}
{{- fail (printf "extra_mise_tools must not override fixed tool %q" $tool) }}
{{- end }}
{{ $tool | quote }} = {{ index $extraMiseTools $tool | quote }}
{{- end }}
# Codex / Claude Code / Antigravity / Grok 使用官方独立安装器。
# 其他 CLI 可通过 data.extra_mise_tools 由 mise 管理。

[settings]
# 开启实验性功能 (有助于解决一些 Python/Node 路径问题)
experimental = true

# =================================================================
# ✅ 环境变量区域 (所有镜像加速都放这里)
# =================================================================
[env]
# --- Node.js 镜像 ---
# 这里的变量名是 node-build (mise 的底层安装器) 识别的标准变量
NODE_MIRROR = "https://npmmirror.com/dist/"
# NPM 包安装源
npm_config_registry = "https://registry.npmmirror.com"

# --- Python 镜像 ---
# python-build 识别的标准变量
PYTHON_BUILD_MIRROR_URL = "https://npmmirror.com/mirrors/python/"

# --- Go 镜像 ---
GOPROXY = "https://goproxy.cn,direct"

# --- Rust 镜像 ---
RUSTUP_DIST_SERVER = "https://mirrors.ustc.edu.cn/rust-static"
RUSTUP_UPDATE_ROOT = "https://mirrors.ustc.edu.cn/rust-static/rustup"

# --- Flutter 镜像 ---
PUB_HOSTED_URL = "https://pub.flutter-io.cn"
FLUTTER_STORAGE_BASE_URL = "https://storage.flutter-io.cn"

# --- Android SDK 路径 ---
# Android path is selected in ~/.zsh/android.zsh so Intel and Apple Silicon
# Homebrew prefixes both work.
