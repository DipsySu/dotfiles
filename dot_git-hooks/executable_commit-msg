#!/bin/sh

# Optional commit-msg hook.  It is deliberately not configured through a
# global core.hooksPath: Git then continues to run every repository's own
# hooks (including hooks in linked worktrees).  Install or symlink this hook
# only in repositories where this narrow trailer cleanup is wanted.

msg_file=${1:-}
[ -n "$msg_file" ] && [ -f "$msg_file" ] || exit 0

tmp_file="${msg_file}.without-machine-coauthors.$$"

awk '
function machine_identity(value, name, email) {
  name = value
  sub(/^[[:space:]]*/, "", name)
  sub(/[[:space:]]*<.*/, "", name)
  sub(/[[:space:]]*$/, "", name)
  name = tolower(name)

  email = value
  sub(/^.*</, "", email)
  sub(/>.*/, "", email)
  sub(/^[[:space:]]*/, "", email)
  sub(/[[:space:]]*$/, "", email)
  email = tolower(email)

  return ((name == "codex" || name == "chatgpt" || name == "openai") && \
          email == "noreply@openai.com") || \
         ((name == "claude" || name == "anthropic") && \
          email == "noreply@anthropic.com")
}
{
  if ($0 ~ /^[[:space:]]*[Cc][Oo]-[Aa][Uu][Tt][Hh][Oo][Rr][Ee][Dd]-[Bb][Yy]:[[:space:]]*/) {
    value = $0
    sub(/^[[:space:]]*[Cc][Oo]-[Aa][Uu][Tt][Hh][Oo][Rr][Ee][Dd]-[Bb][Yy]:[[:space:]]*/, "", value)
    if (machine_identity(value)) next
  }
  print
}
' "$msg_file" > "$tmp_file" && mv "$tmp_file" "$msg_file"

status=$?
[ "$status" -eq 0 ] || rm -f "$tmp_file"
exit "$status"
